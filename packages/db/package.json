{
	"name": "@wave/db",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev"
	},
	"devDependencies": {
		"prisma": "catalog:",
		"tsdown": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5 || ^6"
	},
	"dependencies": {
		"@prisma/client": "catalog:",
		"@trpc/server": "catalog:",
		"dotenv": "catalog:",
		"zod": "catalog:"
	}
}
