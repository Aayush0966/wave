{
	"name": "wave",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "biome check --write .",
		"prepare": "husky",
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"db:push": "turbo -F @wave/db db:push",
		"db:studio": "turbo -F @wave/db db:studio",
		"db:generate": "turbo -F @wave/db db:generate",
		"db:migrate": "turbo -F @wave/db db:migrate"
	},
	"dependencies": {
		"@lottiefiles/dotlottie-react": "^0.17.6",
		"@next/bundle-analyzer": "^15.5.6",
		"@react-email/components": "^0.5.7",
		"@rive-app/react-canvas": "^4.23.4",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@trpc/next": "^11.7.1",
		"@trpc/react-query": "^11.7.1",
		"dotenv": "catalog:",
		"nodemailer": "^7.0.10",
		"pino": "^10.1.0",
		"superjson": "^2.2.5",
		"zod": "^4.1.11",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^22.13.11",
		"@types/nodemailer": "^7.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"ts-node": "^10.9.2",
		"tsdown": "^0.15.5",
		"turbo": "^2.5.4",
		"vitest": "^4.0.5"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "pnpm@10.17.1"
}
