{
	"name": "wave",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "biome check --write .",
		"prepare": "husky",
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"db:push": "turbo -F @wave/db db:push",
		"db:studio": "turbo -F @wave/db db:studio",
		"db:generate": "turbo -F @wave/db db:generate",
		"db:migrate": "turbo -F @wave/db db:migrate",
		"db:clear": "pnpm exec tsx clear-db.ts"
	},
	"dependencies": {
		"@lottiefiles/dotlottie-react": "catalog:",
		"@next/bundle-analyzer": "catalog:",
		"@prisma/adapter-pg": "^7.9.1",
		"@react-email/components": "catalog:",
		"@rive-app/react-canvas": "catalog:",
		"@tailwindcss/aspect-ratio": "catalog:",
		"@tailwindcss/forms": "catalog:",
		"@tailwindcss/typography": "catalog:",
		"@trpc/next": "catalog:",
		"@trpc/react-query": "catalog:",
		"dotenv": "catalog:",
		"next": "catalog:",
		"nodemailer": "catalog:",
		"pg": "^8.23.0",
		"pino": "catalog:",
		"superjson": "catalog:",
		"zod": "catalog:",
		"zustand": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/node": "catalog:",
		"@types/nodemailer": "catalog:",
		"husky": "catalog:",
		"lint-staged": "catalog:",
		"tailwindcss": "catalog:",
		"ts-node": "catalog:",
		"tsdown": "catalog:",
		"tsx": "^4.23.12",
		"turbo": "catalog:",
		"vitest": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "pnpm@10.17.1"
}
